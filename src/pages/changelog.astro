---
import { Icon } from "astro-icon/components";
import { changelogEntries } from "@/data/changelog";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const latest = changelogEntries[0];
const formatDate = (date: string) => date.replaceAll("-", ".");
---

<MainGridLayout title="更新日志" description="博客功能与内容更新记录">
	<section class="log-page">
		<aside class="log-aside">
			<section class="log-hero card-base onload-animation">
				<p class="log-kicker">
					<Icon is:inline name="material-symbols:history-edu-rounded" />
					<span>CHANGELOG</span>
				</p>
				<h1>{latest.title}</h1>
				<p class="log-brief text-75">{latest.brief}</p>
				<p class="log-date">
					<span>最近更新</span>
					<strong>{formatDate(latest.date)}</strong>
				</p>
			</section>

			<nav class="log-nav card-base onload-animation" aria-label="更新目录">
				<p class="log-nav-title">快速跳转</p>
				{changelogEntries.map((entry, index) => (
					<a href={`#log-${index}`}>
						<i></i>
						<span class="log-nav-date">{formatDate(entry.date)}</span>
						{entry.title}
					</a>
				))}
			</nav>
		</aside>

		<div class="log-timeline">
			{changelogEntries.map((entry, index) => (
				<article class="log-entry card-base" id={`log-${index}`}>
					<div class="log-entry-dot" aria-hidden="true"></div>
					<header>
						<p class="log-entry-date">
							<Icon is:inline name="material-symbols:calendar-month-rounded" />
							<span>{formatDate(entry.date)}</span>
						</p>
						<h2>{entry.title}</h2>
						<p class="log-entry-brief text-75">{entry.brief}</p>
						<div class="log-tags">
							{entry.tags.map((tag) => (
								<span class="log-tag">{tag}</span>
							))}
						</div>
					</header>
					<ul class="log-items">
						{entry.items.map((item) => (
							<li>
								<span class="log-item-icon">
									<Icon is:inline name={item.icon} />
								</span>
								<span class="text-75">{item.text}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>
</MainGridLayout>

<style>
	.log-page {
		display: grid;
		grid-template-columns: minmax(13rem, 15rem) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		width: 100%;
		position: relative;
		z-index: 1;
	}

	.log-aside {
		position: sticky;
		top: 4.75rem;
		display: grid;
		gap: 0.75rem;
	}

	.log-hero,
	.log-nav,
	.log-entry {
		border-radius: var(--radius-large);
	}

	.log-hero {
		padding: 1.1rem;
	}

	.log-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.8rem;
		padding: 0.36rem 0.6rem;
		border-radius: 0.5rem;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 13%, transparent);
		font-size: 0.76rem;
		font-weight: 850;
		letter-spacing: 0.08em;
	}

	.log-hero h1 {
		margin: 0;
		font-size: 1.35rem;
		line-height: 1.35;
		font-weight: 900;
	}

	.log-brief {
		margin: 0.6rem 0 0;
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.log-date {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		margin: 0.85rem 0 0;
		padding: 0.6rem 0.7rem;
		border-radius: 0.65rem;
		background: color-mix(in oklab, var(--primary) 9%, transparent);
		font-size: 0.76rem;
		font-weight: 800;
	}

	.log-date strong {
		color: var(--primary);
	}

	.log-nav {
		padding: 0.7rem;
	}

	.log-nav-title,
	.log-entry-date {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		font-size: 0.76rem;
		font-weight: 900;
	}

	.log-nav-title {
		margin: 0 0 0.55rem;
		opacity: 0.55;
	}

	.log-nav a {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.5rem;
		font-size: 0.82rem;
		font-weight: 700;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.log-nav a:hover {
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		transform: translateX(0.12rem);
	}

	.log-nav i {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--primary);
		flex: 0 0 auto;
	}

	.log-nav-date {
		flex: 0 0 auto;
		font-size: 0.74rem;
		font-weight: 850;
		opacity: 0.6;
	}

	.log-timeline {
		display: grid;
		gap: 1rem;
	}

	.log-entry {
		position: relative;
		padding: 1.15rem 1.25rem 1.25rem;
		scroll-margin-top: 6rem;
	}

	.log-entry-dot {
		position: absolute;
		left: -1.42rem;
		top: 1.55rem;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 0.28rem color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.log-entry-date {
		margin: 0 0 0.35rem;
		color: var(--primary);
	}

	.log-entry h2 {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.4;
		font-weight: 900;
	}

	.log-entry-brief {
		margin: 0.4rem 0 0;
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.log-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.7rem;
	}

	.log-tag {
		display: inline-flex;
		align-items: center;
		min-height: 1.6rem;
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		font-size: 0.74rem;
		font-weight: 800;
	}

	.log-items {
		display: grid;
		gap: 0.55rem;
		margin: 0.95rem 0 0;
		padding: 0;
		list-style: none;
	}

	.log-items li {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
		padding: 0.7rem 0.75rem;
		border: 1px solid color-mix(in oklab, var(--line-divider) 70%, transparent);
		border-radius: 0.7rem;
		background: color-mix(in oklab, var(--card-bg) 60%, transparent);
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.log-item-icon {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.55rem;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		font-size: 1rem;
	}

	@media (max-width: 1020px) {
		.log-page {
			grid-template-columns: 1fr;
		}

		.log-aside {
			position: static;
		}

		.log-nav {
			display: none;
		}

		.log-entry-dot {
			display: none;
		}
	}
</style>
