---
import { Icon } from "astro-icon/components";

// 阅读增强：
// 1. ←/→ 方向键翻上一篇/下一篇（输入框聚焦时忽略），优先走 Swup 无刷新导航
// 2. 阅读位置记忆：按 slug 存储阅读进度，14 天内重访时右下角出现「回到上次位置」，
//    点击平滑跳转，不打断从头阅读的意愿
---

<div id="reading-resume" class="reading-resume" hidden>
	<button id="reading-resume-btn" type="button" class="reading-resume-main">
		<Icon is:inline name="material-symbols:history-rounded" class="text-[1.1rem]" />
		<span id="reading-resume-label">回到上次位置</span>
	</button>
	<button id="reading-resume-close" type="button" class="reading-resume-close" aria-label="关闭提示">
		<Icon is:inline name="material-symbols:close" class="text-[0.9rem]" />
	</button>
</div>

<script>
	(() => {
		const enhancerWindow = window as Window & {
			__readerEnhancerInit?: boolean;
			__readerEnhancerBind?: () => void;
			swup?: { navigate: (url: string) => void };
		};
		if (enhancerWindow.__readerEnhancerInit) {
			enhancerWindow.__readerEnhancerBind?.();
			return;
		}
		enhancerWindow.__readerEnhancerInit = true;

		const RESUME_KEY_PREFIX = "firefly-reading-position:";
		const RESUME_MAX_AGE = 14 * 24 * 3600 * 1000;
		const WRITE_INTERVAL = 2000;
		let latestRatio = 0;
		let lastWrite = 0;

		const docMaxScroll = () =>
			document.documentElement.scrollHeight - window.innerHeight;

		const updateRatio = () => {
			const max = docMaxScroll();
			latestRatio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
		};

		const storageKey = () => `${RESUME_KEY_PREFIX}${location.pathname}`;

		const writePosition = (force = false) => {
			const now = Date.now();
			if (!force && now - lastWrite < WRITE_INTERVAL) return;
			lastWrite = now;
			try {
				localStorage.setItem(
					storageKey(),
					JSON.stringify({ ratio: latestRatio, ts: now }),
				);
			} catch {
				/* 隐私模式等场景下 localStorage 不可用，直接忽略 */
			}
		};

		const scrollToRatio = (ratio: number) => {
			window.scrollTo({
				top: ratio * docMaxScroll(),
				behavior: "smooth",
			});
		};

		const bind = () => {
			const wrap = document.getElementById("reading-resume");
			const btn = document.getElementById("reading-resume-btn");
			const label = document.getElementById("reading-resume-label");
			const close = document.getElementById("reading-resume-close");
			if (!wrap || !btn || !label || !close) return;

			try {
				const raw = localStorage.getItem(storageKey());
				let show = false;
				if (raw) {
					const saved = JSON.parse(raw) as { ratio?: number; ts?: number };
					if (
						typeof saved.ratio === "number" &&
						typeof saved.ts === "number" &&
						saved.ratio > 0.08 &&
						saved.ratio < 0.92 &&
						Date.now() - saved.ts < RESUME_MAX_AGE
					) {
						label.textContent = `回到上次位置 · ${Math.round(saved.ratio * 100)}%`;
						btn.onclick = () => {
							scrollToRatio(saved.ratio as number);
							wrap.hidden = true;
						};
						show = true;
					}
				}
				wrap.hidden = !show;
			} catch {
				wrap.hidden = true;
			}
			close.onclick = () => {
				wrap.hidden = true;
			};
		};

		document.addEventListener("keydown", (event) => {
			if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey)
				return;
			if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
			const target = event.target as HTMLElement | null;
			if (
				target &&
				(target.tagName === "INPUT" ||
					target.tagName === "TEXTAREA" ||
					target.tagName === "SELECT" ||
					target.isContentEditable)
			)
				return;
			const link = document.querySelector<HTMLAnchorElement>(
				`a[data-post-nav="${event.key === "ArrowLeft" ? "next" : "prev"}"]`,
			);
			if (!link) return;
			event.preventDefault();
			const href = link.getAttribute("href");
			if (!href) return;
			if (enhancerWindow.swup) enhancerWindow.swup.navigate(href);
			else location.assign(href);
		});

		window.addEventListener(
			"scroll",
			() => {
				requestAnimationFrame(() => {
					updateRatio();
					writePosition();
				});
			},
			{ passive: true },
		);
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) writePosition(true);
		});
		window.addEventListener("pagehide", () => writePosition(true));

		enhancerWindow.__readerEnhancerBind = bind;
		bind();
	})();
</script>

<style>
	.reading-resume {
		position: fixed;
		right: 1.25rem;
		bottom: 7rem;
		z-index: 60;
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
		padding: 0.3rem 0.3rem 0.3rem 0.55rem;
		border: 1px solid color-mix(in oklab, var(--line-divider) 80%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--card-bg) 88%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: 0 10px 28px rgb(0 0 0 / 0.14);
	}

	.reading-resume[hidden] {
		display: none;
	}

	.reading-resume-main {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border: 0;
		background: transparent;
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 800;
		cursor: pointer;
	}

	.reading-resume-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.4rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--primary);
		opacity: 0.55;
		cursor: pointer;
	}

	.reading-resume-close:hover {
		opacity: 1;
	}

	@media (max-width: 640px) {
		.reading-resume {
			right: 0.75rem;
			bottom: 5.5rem;
		}
	}
</style>
