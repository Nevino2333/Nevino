---
import { Icon } from "astro-icon/components";

// 文章朗读：浏览器原生 speechSynthesis，零后端、零 API 成本。
// 文本从 #post-container 采集（剔除代码块等），分句交给合成队列播放。
---

<button
	id="post-tts-btn"
	type="button"
	class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-none hover:text-[var(--primary)]"
	aria-pressed="false"
	title="朗读本文"
	data-tts-state="idle"
>
	<Icon is:inline name="material-symbols:volume-up-rounded" class="text-[1.1rem]" />
</button>

<script>
	(() => {
		const ttsWindow = window as Window & {
			__postTtsInitialized?: boolean;
			__postTtsBind?: () => void;
		};
		if (ttsWindow.__postTtsInitialized) {
			ttsWindow.__postTtsBind?.();
			return;
		}
		ttsWindow.__postTtsInitialized = true;

		const synth = window.speechSynthesis;
		type TtsState = "idle" | "speaking" | "paused";
		// Edge TTS 单次合成 500 字左右（约 30 秒音频），失败自动降级浏览器本地合成
		const EDGE_CHUNK_CHARS = 500;
		const BROWSER_CHUNK_CHARS = 180;
		let mode: "edge" | "browser" = "edge";
		let edgeFailed = false;
		let chunks: string[] = [];
		let state: TtsState = "idle";
		let btn: HTMLButtonElement | null = null;
		let currentAudio: HTMLAudioElement | null = null;
		let releasePlay: (() => void) | null = null;

		const setUi = (next: TtsState, title?: string) => {
			state = next;
			if (!btn) return;
			btn.dataset.ttsState = next;
			btn.setAttribute("aria-pressed", String(next !== "idle"));
			if (title) btn.title = title;
		};

		const collectText = (): string => {
			const container = document.getElementById("post-container");
			if (!container) return "";
			const clone = container.cloneNode(true) as HTMLElement;
			clone
				.querySelectorAll(
					"pre, code, script, style, nav, button, figure, #post-tts-btn",
				)
				.forEach((el) => el.remove());
			return (clone.textContent || "").replace(/\s+/g, " ").trim().slice(0, 20000);
		};

		const chunkText = (text: string, maxChars: number): string[] => {
			// 按句切分并合并到 maxChars 左右，长句型语音合成更稳
			const sentences =
				text.match(/[^。！？!?；;]*[。！？!?；;]|[^。！？!?；;]+$/g) || [];
			const merged: string[] = [];
			let buffer = "";
			for (const sentence of sentences) {
				if ((buffer + sentence).length > maxChars && buffer) {
					merged.push(buffer);
					buffer = sentence;
				} else {
					buffer += sentence;
				}
			}
			if (buffer) merged.push(buffer);
			return merged;
		};

		const stop = () => {
			state = "idle";
			if (currentAudio) {
				const audio = currentAudio;
				currentAudio = null;
				audio.onended = null;
				audio.onerror = null;
				audio.pause();
			}
			if (releasePlay) {
				const release = releasePlay;
				releasePlay = null;
				release();
			}
			if (synth) synth.cancel();
			chunks = [];
			setUi("idle", "朗读本文");
		};

		const fetchEdgeAudio = async (text: string): Promise<string> => {
			const response = await fetch(`/tts?text=${encodeURIComponent(text)}`);
			if (!response.ok) throw new Error(`tts ${response.status}`);
			const blob = await response.blob();
			if (!blob.type.startsWith("audio/")) {
				throw new Error("tts returned non-audio");
			}
			return URL.createObjectURL(blob);
		};

		const playUrl = (url: string) =>
			new Promise<void>((resolve) => {
				const audio = new Audio(url);
				currentAudio = audio;
				releasePlay = resolve;
				audio.onended = () => {
					if (currentAudio === audio) currentAudio = null;
					URL.revokeObjectURL(url);
					resolve();
				};
				audio.onerror = () => {
					if (currentAudio === audio) currentAudio = null;
					URL.revokeObjectURL(url);
					resolve();
				};
				audio.play().catch(() => resolve());
			});

		const speakBrowserFrom = (from: number) => {
			if (!synth) {
				stop();
				return;
			}
			const speakAt = (i: number) => {
				if (state !== "speaking") return;
				if (i >= chunks.length) {
					stop();
					return;
				}
				const utterance = new SpeechSynthesisUtterance(chunks[i]);
				utterance.lang = "zh-CN";
				const voice = synth
					.getVoices()
					.find((item) => item.lang?.toLowerCase().startsWith("zh"));
				if (voice) utterance.voice = voice;
				utterance.onend = () => {
					if (state === "speaking") speakAt(i + 1);
				};
				utterance.onerror = () => stop();
				synth.speak(utterance);
			};
			speakAt(from);
		};

		const speakEdgeFrom = async (from: number) => {
			let prefetch: Promise<string> | null = null;
			for (let i = from; i < chunks.length; i++) {
				if (state !== "speaking") return;
				let url: string;
				try {
					url = await (prefetch ?? fetchEdgeAudio(chunks[i]));
				} catch {
					// Edge TTS 不可用（接口变动/网络问题）：本轮及之后回退浏览器合成
					edgeFailed = true;
					if (state !== "speaking") return;
					mode = "browser";
					speakBrowserFrom(i);
					return;
				}
				// 播放当前句的同时预取下一句，消除句间等待
				prefetch =
					i + 1 < chunks.length ? fetchEdgeAudio(chunks[i + 1]) : null;
				if (state !== "speaking") {
					URL.revokeObjectURL(url);
					return;
				}
				await playUrl(url);
				if (state !== "speaking") return;
			}
			stop();
		};

		const start = () => {
			const text = collectText();
			if (!text) return;
			const useEdge = mode === "edge" && !edgeFailed;
			chunks = chunkText(text, useEdge ? EDGE_CHUNK_CHARS : BROWSER_CHUNK_CHARS);
			setUi("speaking", "暂停朗读");
			if (useEdge) void speakEdgeFrom(0);
			else speakBrowserFrom(0);
		};

		const toggle = () => {
			if (state === "idle") {
				start();
				return;
			}
			if (state === "speaking") {
				if (mode === "edge" && currentAudio) currentAudio.pause();
				else synth?.pause();
				setUi("paused", "继续朗读");
				return;
			}
			if (mode === "edge" && currentAudio) {
				currentAudio.play().catch(() => {});
			} else {
				synth?.resume();
			}
			setUi("speaking", "暂停朗读");
		};

		ttsWindow.__postTtsBind = () => {
			const nextBtn = document.getElementById(
				"post-tts-btn",
			) as HTMLButtonElement | null;
			if (!nextBtn || nextBtn === btn) return;
			if (btn) btn.removeEventListener("click", toggle);
			btn = nextBtn;
			btn.addEventListener("click", toggle);
			// 页面切换（Swup）后旧内容已不在，停止上一页的朗读
			if (state !== "idle") stop();
		};
		ttsWindow.__postTtsBind();
		document.addEventListener("swup:contentReplaced", () => stop());
		window.addEventListener("beforeunload", () => stop());
	})();
</script>
